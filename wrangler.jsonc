{
  // Cloudflare Workers の設定（原則として編集しない）
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gotanda-avenue",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-04-01",

  // 静的ファイル（vite build の出力）を配信し、/api/* だけを Worker が処理する
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },

  // database_id は書かない。初回の `npm run deploy` で Cloudflare 上に D1 が作られる
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gotanda-avenue",
      "migrations_dir": "migrations"
    }
  ]
}
