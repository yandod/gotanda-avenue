{
  "name": "gotanda-avenue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ブラウザ心理実験のテンプレート（jsPsych + Cloudflare Workers + D1）",
  "author": "yandod",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite build && wrangler d1 migrations apply DB --local && wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker",
    "validate": "tsx scripts/validate.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "vite build && wrangler deploy",
    "status": "tsx scripts/status.ts",
    "export": "tsx scripts/export.ts",
    "export:local": "tsx scripts/export.ts --local"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@jspsych/plugin-audio-button-response": "^2.1.1",
    "@jspsych/plugin-audio-slider-response": "^2.1.1",
    "@jspsych/plugin-fullscreen": "^2.1.0",
    "@jspsych/plugin-html-button-response": "^2.1.0",
    "@jspsych/plugin-html-keyboard-response": "^2.2.0",
    "@jspsych/plugin-html-slider-response": "^2.1.0",
    "@jspsych/plugin-image-keyboard-response": "^2.2.0",
    "@jspsych/plugin-image-slider-response": "^2.1.0",
    "@jspsych/plugin-instructions": "^2.1.0",
    "@jspsych/plugin-preload": "^2.1.0",
    "@jspsych/plugin-survey": "^4.0.0",
    "hono": "^4.13.13",
    "jspsych": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.86.0"
  }
}
